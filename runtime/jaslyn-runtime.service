[Unit]
Description=Jaslyn Runtime
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Jaslyn
Environment=JASLYN_BACKEND_URL=http://127.0.0.1:11434/v1
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m uvicorn runtime.jaslyn_runtime:app --host 127.0.0.1 --port 8099
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
