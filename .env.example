# Private/self-hosted inference server. No third-party AI provider is required.
# Must expose an OpenAI-compatible POST /chat/completions endpoint.
JASLYN_INFERENCE_URL=
JASLYN_INFERENCE_TOKEN=
JASLYN_MODEL=jaslyn

# Jaslyn-owned API authentication. Set to 1 to require x-jaslyn-key or
# Authorization: Bearer <key> on /api/run.
JASLYN_REQUIRE_API_KEY=0
PYTHON_BIN=python3

# Jaslyn Net durable PostgreSQL state.
DATABASE_URL=
# Set to disable only for an isolated local network. Production should keep TLS enabled.
DATABASE_SSL=verify
# Set to 0 only when certificate verification is intentionally delegated to the network boundary.
DATABASE_SSL_VERIFY=1
DATABASE_CA_CERT=
JASLYN_DB_POOL_MAX=10

# Jaslyn Net: optional real MikroTik RouterOS v7 REST integration.
# Use HTTPS (www-ssl), never plain HTTP, for production router credentials.
JASLYN_MIKROTIK_URL=
JASLYN_MIKROTIK_USERNAME=
JASLYN_MIKROTIK_PASSWORD=

# Mandatory secret for destructive network commands such as disconnect.
JASLYN_NET_COMMAND_KEY=

# Secret for a trusted FreeRADIUS/RADIUS accounting bridge to POST normalized accounting events.
JASLYN_ACCOUNTING_INGEST_KEY=

# Secret for a trusted payment-provider adapter to POST normalized callbacks.
# Provider-specific signature verification belongs in that adapter before this boundary.
JASLYN_PAYMENT_INGEST_KEY=

# Secret for a trusted payment verifier to activate an already VERIFIED/SETTLED payment.
# This endpoint never verifies a provider transaction itself; it only consumes trusted state.
JASLYN_PAYMENT_ACTIVATION_KEY=
