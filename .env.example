# Private/self-hosted inference server. No third-party AI provider is required.
# Must expose an OpenAI-compatible POST /chat/completions endpoint.
JASLYN_INFERENCE_URL=
JASLYN_INFERENCE_TOKEN=
JASLYN_MODEL=jaslyn

# Jaslyn-owned API authentication. Production APIs are authenticated by default.
# Set JASLYN_ALLOW_ANONYMOUS_API=1 only for an intentionally public local deployment.
JASLYN_ALLOW_ANONYMOUS_API=0
# Bootstrap/admin credential for API-key management. Store only in the deployment secret manager.
JASLYN_ADMIN_KEY=
# Legacy compatibility flag. When enabled, API-key authentication remains required.
JASLYN_REQUIRE_API_KEY=1
PYTHON_BIN=python3
