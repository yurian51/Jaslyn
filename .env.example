# Private/self-hosted inference server. No third-party AI provider is required.
# Must expose an OpenAI-compatible POST /chat/completions endpoint.
JASLYN_INFERENCE_URL=
JASLYN_INFERENCE_TOKEN=
JASLYN_MODEL=jaslyn

# Jaslyn-owned API authentication. Set to 1 to require x-jaslyn-key or
# Authorization: Bearer <key> on /api/run.
JASLYN_REQUIRE_API_KEY=0
PYTHON_BIN=python3

# Jaslyn Net: optional real MikroTik RouterOS v7 REST integration.
# Use HTTPS (www-ssl), never plain HTTP, for production router credentials.
JASLYN_MIKROTIK_URL=
JASLYN_MIKROTIK_USERNAME=
JASLYN_MIKROTIK_PASSWORD=

# Mandatory secret for destructive network commands such as disconnect.
JASLYN_NET_COMMAND_KEY=
